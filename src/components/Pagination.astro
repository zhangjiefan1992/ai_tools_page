---
const { currentPage, totalPages, baseUrl } = Astro.props;

function getPageUrl(page: number): string {
  if (page === 1) return baseUrl;
  return `${baseUrl}/${page}`;
}

function getPageNumbers(): (number | '...')[] {
  if (totalPages <= 5) return Array.from({ length: totalPages }, (_, i) => i + 1);
  const pages: (number | '...')[] = [1];
  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);
  if (start > 2) pages.push('...');
  for (let i = start; i <= end; i++) pages.push(i);
  if (end < totalPages - 1) pages.push('...');
  pages.push(totalPages);
  return pages;
}
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-2 mt-12" aria-label="Pagination">
    {currentPage > 1 ? (
      <a href={getPageUrl(currentPage - 1)} class="px-4 py-2 text-sm border rounded-lg hover:bg-gray-50">
        &larr; Previous
      </a>
    ) : (
      <span class="px-4 py-2 text-sm border rounded-lg text-gray-300 cursor-not-allowed">
        &larr; Previous
      </span>
    )}

    {getPageNumbers().map(page =>
      page === '...' ? (
        <span class="px-2 text-gray-400">...</span>
      ) : (
        <a
          href={getPageUrl(page)}
          class:list={[
            'px-4 py-2 text-sm border rounded-lg',
            page === currentPage
              ? 'bg-blue-600 text-white border-blue-600'
              : 'hover:bg-gray-50',
          ]}
          aria-current={page === currentPage ? 'page' : undefined}
        >
          {page}
        </a>
      )
    )}

    {currentPage < totalPages ? (
      <a href={getPageUrl(currentPage + 1)} class="px-4 py-2 text-sm border rounded-lg hover:bg-gray-50">
        Next &rarr;
      </a>
    ) : (
      <span class="px-4 py-2 text-sm border rounded-lg text-gray-300 cursor-not-allowed">
        Next &rarr;
      </span>
    )}
  </nav>
)}
