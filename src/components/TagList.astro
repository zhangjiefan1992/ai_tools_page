---
interface Props {
  tags: string[];
  activeTag?: string;
}

const { tags, activeTag } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {tags.map(tag => (
    <a
      href={`/tag/${tag}`}
      class:list={[
        'text-sm px-3 py-1 rounded-full transition-colors',
        activeTag === tag
          ? 'bg-blue-600 text-white'
          : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
      ]}
    >
      #{tag}
    </a>
  ))}
</div>
