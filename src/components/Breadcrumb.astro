---
import JsonLd from './seo/JsonLd.astro';
import { SITE } from '../config';

interface Props {
  items: Array<{
    label: string;
    href?: string;
  }>;
}

const { items } = Astro.props;

const jsonLdData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, SITE.url).href } : {}),
  })),
};
---

<nav class="mb-6" aria-label="Breadcrumb">
  <JsonLd type="BreadcrumbList" data={jsonLdData} />
  <ol class="flex items-center gap-2 text-sm text-gray-500">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span class="text-gray-300">/</span>}
        {item.href ? (
          <a href={item.href} class="hover:text-blue-600 transition-colors">{item.label}</a>
        ) : (
          <span class="text-gray-900 font-medium truncate max-w-[200px]">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
