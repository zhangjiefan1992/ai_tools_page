---
import { SITE, SOCIAL_LINKS } from '../config';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-semibold text-gray-900 mb-3">{SITE.name}</h3>
        <p class="text-sm text-gray-600">{SITE.description}</p>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-3">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-gray-600 hover:text-blue-600">About</a></li>
          <li><a href="/privacy-policy" class="text-gray-600 hover:text-blue-600">Privacy Policy</a></li>
          <li><a href="/rss.xml" class="text-gray-600 hover:text-blue-600">RSS Feed</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-3">Follow Us</h3>
        <div class="flex gap-4">
          {SOCIAL_LINKS.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-blue-600"
              aria-label={link.label}
            >
              <Fragment set:html={link.icon} />
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-gray-200 text-center text-sm text-gray-500">
      &copy; {currentYear} {SITE.name}. All rights reserved.
    </div>
  </div>
</footer>
