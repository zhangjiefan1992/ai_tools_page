---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." noindex={true}>
  <div class="max-w-2xl mx-auto px-4 py-20 text-center">
    <h1 class="text-6xl font-extrabold text-gray-200 mb-4">404</h1>
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Page Not Found</h2>
    <p class="text-gray-600 mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/" class="inline-flex items-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">
      &larr; Back to Home
    </a>
  </div>
</BaseLayout>
